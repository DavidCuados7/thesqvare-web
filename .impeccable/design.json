  "narrative": {
    "northStar": "El cuadrado editorial",
    "overview": "The Sqvare se ve como una revista de barrio bien hecha: bloques de color planos, tipografía gruesa en Unbounded y un ritmo de pantallas completas que se suceden como páginas. Nada es redondo. El cuadrado es la forma de la marca.",
    "keyCharacteristics": [
      "Formas rectas y bloques de color, sin esquinas redondeadas.",
      "Titulares gruesos en Unbounded con una palabra destacada en dorado.",
      "Sombras duras de color, sin difuminar.",
      "Una pantalla por bloque de color de fondo."
    ],
    "rules": [
      {
        "name": "The Un-Shade Rule",
        "body": "Los colores son planos. No hay degradados de marca.",
        "section": "colors"
      },
      {
        "name": "The One Gold Rule",
        "body": "El dorado aparece en el botón principal y en una palabra por pantalla.",
        "section": "colors"
      },
      {
        "name": "The Highlight Box Rule",
        "body": "Una palabra del titular puede ir en un recuadro dorado con texto noche. Solo una por titular.",
        "section": "typography"
      },
      {
        "name": "The Hard Shadow Rule",
        "body": "Las sombras son sólidas y sin difuminar. Nunca usar blur.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar un solo fondo de color por pantalla.",
      "Do usar Unbounded 800 para titulares.",
      "Do usar sombras sólidas de 3 a 8 px.",
      "Do mantener las esquinas rectas."
    ],
    "donts": [
      "Don't usar border-radius en botones, tarjetas o bloques.",
      "Don't usar sombras difuminadas ni degradados de marca.",
      "Don't poner más de una palabra dorada por titular.",
      "Don't recolorear ni modificar el logo.",
      "Don't usar colores de apps de reservas reales."
    ]
  }
